# Шаблон переменных окружения. НЕ содержит реальных значений — коммитится в git.
#
# Локальная разработка: скопируйте в `.env.local` (уже в .gitignore) и заполните
# dev-значениями. Staging/production: переменные задаются в дашборде хостинга
# (Vercel Project Settings → Environment Variables), НЕ через файлы в репозитории.
# Полная стратегия окружений — см. ENVIRONMENTS.md.
#
# NODE_ENV сюда не входит — Next.js выставляет его автоматически
# (dev/build/start), вручную его задавать не нужно.

# --- PostgreSQL (Prisma) ---
# Dev: локальный Postgres или dev-ветка Neon.
# Staging/production: отдельная ветка/база Neon на каждое окружение — общая база
# между окружениями запрещена (30_SECURITY_PRIVACY.md §62; 46_..._RELIABILITY.md §4).
DATABASE_URL=

# --- Redis (BullMQ) ---
# Dev: локальный Redis или dev-инстанс Upstash.
# Staging/production: отдельный инстанс Upstash на каждое окружение.
REDIS_URL=

# --- Auth.js (App Authentication, не Instagram OAuth — см. CLAUDE.md §3.2) ---
# AUTH_SECRET используется Auth.js для подписи сессий/токенов; генерируется
# отдельно на каждое окружение (никогда не переиспользуется между dev/staging/production).
AUTH_SECRET=

# --- AI provider (Anthropic Claude API, через AIProvider — см. src/ai) ---
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-sonnet-5

# --- Object storage (Cloudflare R2, через ObjectStorageService — см. src/storage) ---
# Отдельный bucket на каждое окружение.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Observability (Sentry) ---
SENTRY_DSN=
